---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { site, isLive } from '../data/site';
import { sameAs } from '../data/social';
import { personSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  article?: boolean;
}
const { title, description, article = false } = Astro.props;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || '').trim().replace(/\/$/, '');
const canonical = isLive && siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : undefined;
const ogImage = siteUrl ? `${siteUrl}/og.png` : '/og.png';
const fullTitle = title === 'home' ? 'CAVELDON · Cloud & Operational Engineering' : `${title} · CAVELDON`;
const orgJson = isLive && siteUrl ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: siteUrl,
  description: site.description,
  logo: `${siteUrl}/assets/favicon.svg`,
  slogan: site.shortDescription,
  areaServed: ['Worldwide'],
  // sameAs ties every real profile back to this one entity, so a search for
  // the founder and a search for the brand land on the same organisation.
  ...(sameAs.length ? { sameAs } : {}),
  knowsAbout: ['AWS', 'Cloud infrastructure', 'DevOps', 'CI/CD', 'Infrastructure as code', 'SOC 2', 'Cloud security', 'Site reliability engineering', 'Disaster recovery', 'Cloud cost optimisation', 'FinOps', 'Audit readiness', 'Cloud governance', 'Azure', 'Data protection', 'Technical due diligence'],
  ...(personSchema() ? { founder: personSchema() } : {}),
}) : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F5F1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isLive && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="CAVELDON" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    {isLive && siteUrl && <link rel="sitemap" href="/sitemap.xml" />}
    <link rel="alternate" type="application/rss+xml" title="CAVELDON — guides and reference designs" href="/rss.xml" />
    {orgJson && <script type="application/ld+json" set:html={orgJson} />}
    <Analytics />
    <!-- Motion: mark the document as script-capable, and guarantee that content
         is never left hidden if motion.js fails to load. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      window.__cvMotionFallback = setTimeout(function () {
        document.documentElement.classList.remove('js');
      }, 2500);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="rails" aria-hidden="true"></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline defer src="/site.js"></script>
    <script is:inline defer src="/motion.js"></script>
  </body>
</html>
