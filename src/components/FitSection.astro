---
/**
 * "Is this for you?" — a disqualifier section.
 *
 * Research on 2026 SaaS sites (Linear, Posthog) shows that explicitly ruling
 * out the wrong buyer shortens sales cycles: the right buyer feels seen, the
 * wrong buyer opts out before taking a call. It also suits CAVELDON's existing
 * honesty position, so this adds trust rather than subtracting it.
 */
const notFor = [
  {
    who: 'You need a formal certification or a legal opinion',
    why: 'SOC 2, ISO 27001, HIPAA and DORA reports are issued by independent auditors and accredited bodies. We prepare the technical controls and the evidence behind them.',
  },
  {
    who: 'You want 24/7 monitoring staffed from your timezone',
    why: 'We are a small, founder-led practice. We design and improve monitoring, alerting and response. Running a 24/7 follow-the-sun operations team is a different business.',
  },
  {
    who: 'You are looking for a team to sit inside your org chart',
    why: 'We are engaged for defined scopes with clear handover. If you need a full-time department, a recruiter or a staff-augmentation partner is the better fit.',
  },
  {
    who: 'The work is already finished and just needs documenting',
    why: 'If the fixes are known and only the paperwork is outstanding, a documentation-only engagement is fine — but it is rarely the highest-value use of a budget.',
  },
];
const goodFor = [
  'A cloud estate that grew faster than the team running it',
  'An upcoming audit, security review or customer security questionnaire',
  'A release process that depends on one person being careful',
  'Cloud spend that nobody can explain line by line',
  'Managed servers, patching and a helpdesk that need a documented standard',
];
---

<section class="section" id="fit" aria-labelledby="fit-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Before we talk</p>
        <h2 id="fit-title">Who this works for — and who it does not.</h2>
      </div>
      <p class="intro">We would rather you self-select than sit through a discovery call that was never going to help. If you are on the right-hand list, we will usually be able to help.</p>
    </div>

    <div class="fit-grid">
      <div class="fit-col fit-col--yes">
        <h3 class="fit-head"><span class="fit-mark" aria-hidden="true">✓</span> A good fit if</h3>
        <ul class="fit-list">
          {goodFor.map(item => <li>{item}</li>)}
        </ul>
      </div>
      <div class="fit-col fit-col--no">
        <h3 class="fit-head"><span class="fit-mark" aria-hidden="true">×</span> Not a fit if</h3>
        <ul class="fit-list">
          {notFor.map(item => (
            <li>
              <b>{item.who}</b>
              <span>{item.why}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
