---
/**
 * Who we work with — sized honestly.
 *
 * The same four practices apply at very different scales, and the honest thing
 * is to say which scale each one suits. A one-person shop and a 500-person
 * organisation do not need the same thing, and pretending otherwise is how a
 * services site ends up making a promise it cannot keep.
 */
const segments = [
  {
    size: '1–5 people',
    label: 'A very small team, or a founder doing this themselves',
    need: 'You have production infrastructure and nobody whose job it is. You do not need a platform team — you need someone accountable who will look at what you have and tell you what is actually broken.',
    fit: 'Cloud Setup & Handover ($900), Cloud Readiness Review, and one-off project work.',
    also: 'If you are pre-product and pre-revenue, a review may not be the right spend. We will say so.',
    color: 1,
  },
  {
    size: '5–50 people',
    label: 'A growing software team with a platform engineer or two',
    need: 'Your release process depends on one person being careful, and your cloud bill has grown faster than your understanding of it. You want a documented baseline before you add more.',
    fit: 'Cloud Readiness Review, Evidence & Audit Prep, and focused project work.',
    also: 'Most of our work starts here, and most engagements end with a documented handover to your own team.',
    color: 2,
  },
  {
    size: '50–500 people',
    label: 'A company with an IT team that is now the bottleneck',
    need: 'You have engineers, but nobody owns security posture, cost, or the evidence an enterprise customer asks for. You are also probably losing deals or renewing on autopilot because of it.',
    fit: 'Managed Infrastructure & Support, Evidence & Audit Prep, and the security and compliance work that comes with enterprise customers.',
    also: 'Enterprise questionnaires and audits are where the schedule is tightest. Tell us the deadline on the first call.',
    color: 3,
  },
  {
    size: '500+ people',
    label: 'A company with an internal platform function',
    need: 'You have the team and probably the tooling. What you are missing is capacity at the edges — the migrations, the audits, the odd specialised review that does not justify a hire.',
    fit: 'Scoped project work and overflow delivery, usually white-label through your own MSP or consultancy.',
    also: 'At this size we are a bench, not a partner. That is a fine arrangement and we will be explicit about it.',
    color: 4,
  },
];
---

<section class="section" id="who" aria-labelledby="who-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Who this fits</p>
        <h2 id="who-title">By size, because the need changes completely.</h2>
      </div>
      <p class="intro">
        A two-person team and a five-hundred-person company have almost nothing in common
        technically. What follows is which of our four practices fits each, and where
        we will tell you that you need something else.
      </p>
    </div>

    <div class="seg-list">
      {segments.map(s => (
        <article class={`seg seg--p${s.color}`}>
          <div class="seg-size">
            <span class="seg-n">{s.size}</span>
            <span class="seg-label">{s.label}</span>
          </div>
          <div class="seg-body">
            <p class="seg-need">{s.need}</p>
            <p class="seg-fit"><b>What fits:</b> {s.fit}</p>
            <p class="seg-also">{s.also}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
