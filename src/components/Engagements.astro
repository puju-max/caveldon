---
/**
 * Starting engagements, with real numbers.
 *
 * Pricing calibration (2026 published market rates):
 *   - India independent: $25-35 junior / $35-50 mid / $50-80 senior per hour
 *   - US / Western EU: $100-150 junior / $150-220 mid / $220-300+ senior
 *   - Fixed-scope assessment work: $3K-8K for a maturity assessment
 *   - Managed DevOps retainer: SMB $2.5K-5K/mo, mid-market $6K-15K/mo
 *   - Boutique senior-led consultancy: $8K-30K/mo
 *
 * We price on the work and the risk carried, not on geography. A founder reading this
 * should be able to tell whether we are in their range before they send a message.
 */
import { engagements, type Engagement } from '../data/pricing';

const tiers = engagements.filter(e => e.practice !== 4);
const managed = engagements.find(e => e.practice === 4)!;
const total = engagements.length;

---

<section class="section section--alt" id="engagements" aria-labelledby="engagements-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Starting engagements</p>
        <h2 id="engagements-title">{total} ways to start, with the price on the page.</h2>
      </div>
      <p class="intro">Every engagement is fixed scope and fixed price, agreed before any paid work begins. If a review shows the real problem is smaller than the engagement you had in mind, we will say so and reduce it.</p>
    </div>

    <div class="tier-grid">
      {tiers.map(t => (
        <article class={`tier practice p-${t.practice}`}>
          <div class="practice-top">
            <p class="tier-for">{t.for}</p>
            <span class="pc-num">0{t.practice}</span>
          </div>
          <h3 class="tier-name">{t.name}</h3>
          <p class="tier-price">
            <span class="amount">{t.amount}</span>
            <span class="per">{t.per}</span>
          </p>
          <ul class="tier-list">
            {t.includes.map(i => <li>{i}</li>)}
          </ul>
          <p class="tier-note">{t.note}</p>
          <a class="link" href="/contact/#form">{t.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>

    <div class="tier-grid tier-grid--one" style="margin-top:20px">
      <article class={`tier practice p-${managed.practice}`}>
        <div class="practice-top">
          <p class="tier-for">{managed.for}</p>
          <span class="pc-num">0{managed.practice}</span>
        </div>
        <h3 class="tier-name">{managed.name}</h3>
        <p class="tier-price">
          <span class="amount">{managed.amount}</span>
          <span class="per">{managed.per}</span>
        </p>
        <ul class="tier-list">
          {managed.includes.map(i => <li>{i}</li>)}
        </ul>
        <p class="tier-note">{managed.note}</p>
        <a class="link" href="/contact/#form">{managed.cta} <span aria-hidden="true">→</span></a>
      </article>
    </div>

    <p class="price-note">
      <b>On how we price:</b> by the scope of the work and the risk we carry, not by
      where we are based. A US or EU senior consultant bills $150–300 an hour; an
      equivalent practitioner in India bills $50–80. We do not price on geography —
      we price on the outcome, and we hold a fixed price against it. A $1,500 assessment
      that tells you the answer is "you do not need this" is still worth buying.
    </p>
  </div>
</section>
