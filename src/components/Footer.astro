---
import BrandMark from './BrandMark.astro';
import SocialLinks from './SocialLinks.astro';
import { site, isLive } from '../data/site';
import { visibleInsights } from '../lib/content';
const hasInsights = (await visibleInsights()).length > 0;
---
<footer class="site-footer">
  <div class="wrap footer-main">
    <div>
      <a class="brand" href="/" aria-label="CAVELDON home"><BrandMark /><span>CAVELDON<span class="brand-stop" aria-hidden="true">.</span></span></a>
      <p>{site.description}</p>
      <div class="footer-social">
        <SocialLinks size="sm" />
        <a class="footer-rss" href="/rss.xml"><span class="rss-mark" aria-hidden="true">◔</span> RSS feed</a>
      </div>
    </div>
    <div class="footer-col">
      <span class="label">Services</span>
      <a href="/services/">All services</a>
      <a href="/services/cloud-migration/">Cloud migration &amp; modernization</a>
      <a href="/services/#security">Security &amp; governance</a>
      <a href="/services/#reliability">Reliability &amp; FinOps</a>
      <a href="/services/#solutions">Starting engagements</a>
    </div>
    <div class="footer-col">
      <span class="label">Company</span>
      <a href="/startups/">For startups</a>
      <a href="/services/#team">Engineering support</a>
      <a href="/experience/">Experience</a>
      <a href="/about/">About</a>
      <a href="/work/">Engineering Lab</a>
      {hasInsights && <a href="/insights/">Insights</a>}
      <a href="/setup/">Cloud setup for small teams</a>
      <a href="/checklist/">Free checklist</a>
      <a href="/partner/">For MSPs (white-label)</a>
      <a href="/community/">Community</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/legal/">Legal</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© <span id="year">{new Date().getFullYear()}</span> CAVELDON{!isLive && ' · Prelaunch preview'}</span>
    <span>AWS &amp; Azure · Cloud engineering · Built to be understood</span>
  </div>
</footer>
