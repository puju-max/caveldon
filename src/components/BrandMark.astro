---
/** The C— secondary mark, drawn in the current text colour. Decorative next to the wordmark. */
interface Props { class?: string; }
const { class: cls = 'brand-mark' } = Astro.props;
---
<svg class={cls} viewBox="0 0 112 88" fill="none" aria-hidden="true" focusable="false">
  <path d="M55 16.5C50 13.4 44 12 38 12C20.5 12 9 26.2 9 44S20.5 76 38 76C44 76 50 74.6 55 71.5" stroke="currentColor" stroke-width="9" stroke-linecap="square"/>
  <path d="M68 44H103" stroke="var(--accent)" stroke-width="8" stroke-linecap="square"/>
</svg>
