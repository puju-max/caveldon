---
interface Props { label: string; }
const { label } = Astro.props;
---
<svg class="diag" viewBox="0 0 720 400" role="img" aria-label={label}>
  <defs><marker id="cp-ah" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" style="fill:var(--ink)"/></marker></defs>
  <text class="t-label" x="4" y="16">AWS ACCOUNT · ONE REGION</text>
  <rect class="group" x="4" y="26" width="712" height="266"/>

  <rect class="box" x="24" y="112" width="150" height="78"/>
  <text class="t-label" x="36" y="134">01 · EDGE</text><text class="t-title" x="36" y="158">Clients + WAF</text><text class="t-sub" x="36" y="177">access to the service</text>
  <rect class="box" x="214" y="112" width="150" height="78"/>
  <text class="t-label" x="226" y="134">02 · ROUTING</text><text class="t-title" x="226" y="158">Load balancer</text><text class="t-sub" x="226" y="177">TLS · health checks</text>

  <rect class="group" x="404" y="44" width="296" height="230"/>
  <text class="t-label" x="416" y="64">PRIVATE SUBNETS</text>
  <rect class="box-hl" x="424" y="78" width="256" height="72"/>
  <text class="t-label" x="436" y="99">ZONE A</text><text class="t-title" x="436" y="121">ECS Fargate service</text><text class="t-sub" x="436" y="139">stateless app tasks</text>
  <rect class="box-hl" x="424" y="184" width="256" height="72"/>
  <text class="t-label" x="436" y="205">ZONE B</text><text class="t-title" x="436" y="227">ECS Fargate service</text><text class="t-sub" x="436" y="245">second availability zone</text>

  <path class="ln" d="M174 151H210" marker-end="url(#cp-ah)"/>
  <path class="ln" d="M364 151H390V114H420M390 151V220H420" />
  <circle class="dot" cx="424" cy="114" r="3.5"/><circle class="dot" cx="424" cy="220" r="3.5"/>

  <text class="t-label" x="4" y="318">SUPPORTING LAYERS</text>
  <path class="dash" d="M118 292V328M360 292V328M602 292V328"/>
  <rect class="box" x="4" y="328" width="228" height="68"/>
  <text class="t-label" x="16" y="348">BUILD + RELEASE</text><text class="t-title" x="16" y="370">Pipeline · ECR</text><text class="t-sub" x="16" y="388">tested images, rollback</text>
  <rect class="box" x="246" y="328" width="228" height="68"/>
  <text class="t-label" x="258" y="348">IDENTITY + SECRETS</text><text class="t-title" x="258" y="370">IAM · Secrets Manager</text><text class="t-sub" x="258" y="388">scoped permissions</text>
  <rect class="box" x="488" y="328" width="228" height="68"/>
  <text class="t-label" x="500" y="348">OBSERVABILITY</text><text class="t-title" x="500" y="370">CloudWatch</text><text class="t-sub" x="500" y="388">logs · metrics · alerts</text>
</svg>
