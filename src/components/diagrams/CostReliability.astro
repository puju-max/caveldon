---
interface Props { label: string; }
const { label } = Astro.props;
const steps = [
  ['01 · OBSERVE', 'Measure', 'baseline signals'],
  ['02 · EVALUATE', 'Decide', 'explicit trade-offs'],
  ['03 · CHANGE', 'Adjust', 'one change at a time'],
  ['04 · VERIFY', 'Check', 'result vs baseline'],
];
const x = (i: number) => 4 + i * 185;
const guards = [['Cost', 'allocated spend'], ['Performance', 'latency under load'], ['Reliability', 'errors · recovery'], ['Team effort', 'time to operate']];
---
<svg class="diag" viewBox="0 0 720 370" role="img" aria-label={label}>
  <defs>
    <marker id="cr-ah" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" style="fill:var(--ink)"/></marker>
    <marker id="cr-ahA" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" style="fill:var(--accent)"/></marker>
  </defs>
  {steps.map((s, i) => (
    <g>
      <rect class={i === 3 ? 'box-hl' : 'box'} x={x(i)} y="36" width="156" height="92"/>
      <text class="t-label" x={x(i) + 14} y="60">{s[0]}</text>
      <text class="t-title" x={x(i) + 14} y="88">{s[1]}</text>
      <text class="t-sub" x={x(i) + 14} y="110">{s[2]}</text>
      {i < 3 && <path class="ln" d={`M${x(i) + 156} 82H${x(i + 1) - 3}`} marker-end="url(#cr-ah)"/>}
    </g>
  ))}
  <path class="acc-dash" d="M637 128V152H82V133" marker-end="url(#cr-ahA)"/>
  <text class="t-label" x="360" y="172" text-anchor="middle">REPEAT WITH THE NEXT HYPOTHESIS</text>

  <rect class="box" x="4" y="196" width="712" height="168"/>
  <text class="t-label" x="24" y="224">MEASURED TOGETHER, SO SAVINGS NEVER BREAK THINGS</text>
  <path class="ln" d="M24 238H696" style="stroke:var(--line-2)"/>
  <path class="ln" d="M182 254V330M360 254V330M538 254V330" style="stroke:var(--line-2)"/>
  {guards.map((g, i) => (
    <g>
      <text class="t-title" x={24 + i * 178} y="282">{g[0]}</text>
      <text class="t-sub" x={24 + i * 178} y="304">{g[1]}</text>
    </g>
  ))}
  <text class="t-sub" x="24" y="350">No change ships unless all four stay within agreed limits.</text>
</svg>
