---
/**
 * Profile badge row.
 *
 * Deliberately monograms rather than other companies' trademarked logos: it
 * matches the engineer's-drawing look, it cannot be mistaken for an official
 * badge, and it stays one consistent visual language across every channel.
 * The channel name is on the link's accessible name and tooltip.
 */
import { liveChannels, type Tier } from '../data/social';

interface Props {
  /** Restrict to one tier. Omit for all live profiles. */
  tier?: Tier;
  /** 'sm' for footers and dense areas, 'md' for the community page. */
  size?: 'sm' | 'md';
  /** Show the channel name next to the badge. */
  labelled?: boolean;
}

const { tier, size = 'md', labelled = false } = Astro.props;
const list = tier ? liveChannels.filter(c => c.tier === tier) : liveChannels;
---

{list.length > 0 && (
  <ul class:list={['social-row', `social-row--${size}`, { 'social-row--labelled': labelled }]}>
    {list.map(c => (
      <li>
        <a
          href={c.url}
          rel="me noopener"
          target="_blank"
          title={`${c.label} — ${c.handle}`}
        >
          <span class="social-mark" aria-hidden="true">{c.monogram}</span>
          <span class="social-name">{c.label}</span>
        </a>
      </li>
    ))}
  </ul>
)}
