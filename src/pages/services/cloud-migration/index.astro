---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumbSchema, serviceSchema } from '../../../lib/schema';
import { visibleInsights } from '../../../lib/content';
const hasReadinessGuide = (await visibleInsights()).some(p => p.id === 'aws-production-readiness');
const paths = [
  { title:'Cloud environment setup', detail:'Design account or subscription structure, environments, access and networking for the software you plan to run.' },
  { title:'Application & server migration', detail:'Understand dependencies and move appropriate workloads from existing servers, data centers or hosting environments.' },
  { title:'Database & data migration', detail:'Plan compatibility, data movement, integrity checks, backups and application cutover sequencing.' },
  { title:'Cloud-to-cloud migration', detail:'Evaluate changing providers, regions or infrastructure patterns without assuming every workload should move.' },
  { title:'Infrastructure modernization', detail:'Move toward manageable deployment automation, container hosting or platform services where they fit the workload.' },
  { title:'Hybrid infrastructure', detail:'Consider private-network connections, staged moves and workloads that cannot migrate together.' },
];
const stages = [
  { title:'Discover', body:'Map applications, dependencies, data, security and operational ownership.' },
  { title:'Design', body:'Choose destination, migration method, sequence and acceptance criteria.' },
  { title:'Prepare', body:'Back up, secure access, test dependencies and rehearse where feasible.' },
  { title:'Move', body:'Execute a controlled transition with monitoring and rollback decisions.' },
  { title:'Validate', body:'Check data integrity, behavior, performance, protection and handover.' },
];
---
<BaseLayout title="Cloud Migration & Modernization" description="Cloud environment setup, application and database migration, hybrid and cloud-to-cloud moves with clear cutover, validation and handover plans.">
  <JsonLd data={[breadcrumbSchema([{name:'Services',path:'/services/'},{name:'Cloud Migration & Modernization',path:'/services/cloud-migration/'}]),serviceSchema('Cloud Migration & Modernization','Cloud setup, application and data migration planning, cutover validation and operational handover.','/services/cloud-migration/')]} />
  <section class="page-hero gridpaper">
    <div class="wrap page-hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span>Cloud Migration</span></nav>
        <p class="eyebrow">Cloud & Platform Engineering / Migration</p>
        <h1>Move carefully. Build for what comes next.</h1>
        <p class="lead">Cloud migration is more than moving servers. We help plan the transition of applications, databases and infrastructure—with attention to continuity, data protection, cost and the way teams will operate the result.</p>
        <div class="actions"><a class="btn btn-solid" href="/contact/#form">Discuss your migration <span class="arr" aria-hidden="true">→</span></a><a class="btn btn-ghost" href="#scope">Explore the scope <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
      <figure class="frame" style="margin:0" aria-label="Migration flow diagram">
        <div class="frame-cap"><span>Architecture / Reference flow</span><span>C— / 01</span></div>
        <svg viewBox="0 0 540 285" role="img" aria-labelledby="mig-title mig-desc">
          <title id="mig-title">A controlled cloud migration</title><desc id="mig-desc">Existing systems move through planning and validation to a target cloud environment, with rollback and security review across the whole transition.</desc>
          <defs><pattern id="miggrid" width="21" height="21" patternUnits="userSpaceOnUse"><path d="M21 0H0V21" stroke="#d8dedf" stroke-width=".8" fill="none"/></pattern></defs>
          <rect x="0" y="0" width="540" height="285" fill="url(#miggrid)"/>
          <g font-family="sans-serif" font-size="13" fill="#142237">
            <rect x="18" y="77" width="130" height="106" fill="#fbfbf9" stroke="#718293"/>
            <rect x="210" y="77" width="124" height="106" fill="#e8f2ee" stroke="#2a8079"/>
            <rect x="396" y="77" width="126" height="106" fill="#fbfbf9" stroke="#718293"/>
            <text x="83" y="110" text-anchor="middle" font-size="15" font-weight="600">Existing</text><text x="83" y="130" text-anchor="middle">systems</text><text x="83" y="155" text-anchor="middle" font-size="11">Applications · Data</text>
            <text x="272" y="110" text-anchor="middle" font-size="15" font-weight="600">Controlled</text><text x="272" y="130" text-anchor="middle">transition</text><text x="272" y="155" text-anchor="middle" font-size="11">Test · Cutover</text>
            <text x="459" y="110" text-anchor="middle" font-size="15" font-weight="600">Target cloud</text><text x="459" y="132" text-anchor="middle">environment</text><text x="459" y="155" text-anchor="middle" font-size="11">Operate · Validate</text>
            <path d="M148 130H210M334 130H396" fill="none" stroke="#2a8079" stroke-width="2"/>
            <path d="M200 124L210 130L200 136M386 124L396 130L386 136" fill="none" stroke="#2a8079" stroke-width="2"/>
            <path d="M84 192V223H460V192" fill="none" stroke="#718293" stroke-width="1.25" stroke-dasharray="4 4"/>
            <text x="271" y="245" text-anchor="middle" font-size="12">Security · Data integrity · Recovery criteria</text>
            <text x="18" y="40" font-family="monospace" font-size="12" fill="#547083">DISCOVER / DESIGN / MOVE / VALIDATE</text>
          </g>
        </svg>
        <figcaption class="frame-foot">Illustrative workflow, not a claim of delivered client work.</figcaption>
      </figure>
    </div>
  </section>
  <section class="section" id="scope" aria-labelledby="scope-title">
    <div class="wrap">
      <div class="sec-head"><div><p class="eyebrow">What falls under migration</p><h2 id="scope-title">Different starting points. One disciplined approach.</h2></div><p class="intro">Not every system needs the same migration method. We review the workload and choose the appropriate level of change.</p></div>
      <div class="cells cols-3">{paths.map((x,i)=><article><span class="cell-num">0{i+1} / CAPABILITY</span><h3 style="margin:16px 0 12px">{x.title}</h3><p style="color:var(--ink-2);font-size:16px">{x.detail}</p></article>)}</div>
      <p class="aside-note"><span class="label">Application-specific scope</span> Business-platform migrations, such as Microsoft Dynamics 365, may need dedicated application, data-model and integration expertise; these are evaluated separately and are not assumed to be included.</p>
    </div>
  </section>
  <section class="section section--alt" aria-labelledby="approach-title">
    <div class="wrap"><div class="sec-head"><div><p class="eyebrow">Our method</p><h2 id="approach-title">Five steps to a responsible transition.</h2></div><p class="intro">The sequence and effort depend on system complexity, compliance obligations and acceptable downtime. We agree on deliverables and responsibilities before beginning.</p></div>
    <ol class="migration-stages" style="padding:0;margin:0">{stages.map((x,i)=><li><span class="cell-num">0{i+1}</span><h3>{x.title}</h3><p>{x.body}</p></li>)}</ol>
    </div>
  </section>
  <section class="section" aria-labelledby="migration-outputs"><div class="wrap two-col">
    <div><p class="eyebrow">What you could receive</p><h2 id="migration-outputs">Practical outputs, clearly scoped.</h2><p class="intro" style="margin-top:20px">A cloud migration should leave teams with documented ownership and a system they can support—not just a successful transfer.</p></div>
    <div><ul class="checks done"><li>Discovery summary and dependency map</li><li>Target architecture with trade-offs and agreed assumptions</li><li>Migration, cutover, backup and rollback plan</li><li>Validation criteria and test results for work actually executed</li><li>Runbooks, security responsibilities and operational handover</li></ul><p class="aside-note">Actual deliverables depend on the agreed engagement scope. No downtime guarantees or prior client outcomes are implied.</p></div>
  </div></section>
  <section class="section section--alt" aria-labelledby="migration-proof"><div class="wrap">
    <div class="sec-head"><div><p class="eyebrow">Related engineering</p><h2 id="migration-proof">Explore the thinking behind the work.</h2></div><p class="intro">These are educational resources and proposed architectures—not evidence of completed migrations for customers.</p></div>
    <div class="cells cols-2"><article class="svc"><span class="cell-num">ENGINEERING LAB / REFERENCE</span><h3>A cloud platform designed for safer change.</h3><p>Our architecture proposal for secure hosting, repeatable delivery and operational signals.</p><a class="link" href="/work/cloud-production-architecture/">View the reference study →</a></article>{hasReadinessGuide && <article class="svc"><span class="cell-num">INSIGHTS / GUIDE</span><h3>Production readiness on AWS</h3><p>A guide to the practical work behind operating cloud workloads reliably.</p><a class="link" href="/insights/aws-production-readiness/">Read the engineering guide →</a></article>}</div>
  </div></section>
  <CtaBlock title="Planning a cloud migration?" text="Tell us what is moving, the constraints you know, and what concerns you. You don't need to select the destination technology before contacting us." />
</BaseLayout>
