---
/**
 * The partner page — how MSPs buy delivery from us.
 *
 * The homepage carries a summary of the two ways to work with us. This page
 * is the full arrangement, because an MSP owner is not going to engage a
 * subcontractor on a promise. They need to know:
 *
 *   - what the work looks like from their side
 *   - what they get back, and in what form
 *   - what it costs them, and what they keep
 *   - what we need from them to start
 *   - what we will never do
 *
 * Every number here is derived from src/data/pricing.ts, so it cannot disagree
 * with the pricing on the homepage.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { engagements, wholesale, partnerMargin, WHOLESALE_RATE } from '../data/pricing';

const rate = Math.round(WHOLESALE_RATE * 100);

const situations = [
  {
    t: 'You won the work and cannot staff it',
    d: 'A client signed for a migration, an audit-readiness project or a managed operations handover, and you do not have the people to deliver it in the window they agreed.',
    fit: 'This is the most common reason, and the easiest fit. One engagement, one scope, one handover.',
  },
  {
    t: 'The work needs a specialist you do not have',
    d: 'Your client needs cloud security controls, evidence and audit preparation, or a FinOps analysis, and you would rather not build that capability internally.',
    fit: 'We deliver as your subcontractor. Your client sees your name, your proposal and your invoice.',
  },
  {
    t: 'You are being asked for evidence you cannot produce',
    d: 'A client questionnaire asks for proof about MFA enforcement, endpoint coverage, restore testing or privileged access, and you have the tools but not the evidence.',
    fit: 'The Evidence & Audit Prep engagement is built for exactly this, and it hands you a package you can re-run.',
  },
  {
    t: 'You are reselling managed operations',
    d: 'You want a bench behind your helpdesk and your cloud practice, for the clients where a 24/7 or on-site commitment matters.',
    fit: 'Managed Infrastructure & Support, on our published wholesale rate, with your escalation path on the paperwork.',
  },
];

const steps = [
  {
    n: '01',
    t: 'You bring the scope, or we scope it with you',
    d: 'Usually you already have a statement of work from your client and a price they have signed. We review it, tell you honestly whether we can deliver it, and where it is genuinely underspecified we say so before anyone commits.',
  },
  {
    n: '02',
    t: 'We agree the terms in writing',
    d: 'Scope, fixed price, turnaround, what counts as done, how access is granted and how escalations run. You get the same fixed price we publish, at the wholesale rate, and you can see exactly what you are reselling.',
  },
  {
    n: '03',
    t: 'Access is set up in your client’s own account',
    d: 'Not a copy, not an export, not our account. Your client grants access in their own environment, under least privilege, scoped to the work, with an expiry if you want one. If your client revokes it, we stop.',
  },
  {
    n: '04',
    t: 'We do the work, in your name',
    d: 'Every artefact — findings, runbooks, code, the handover document — is written for you to send on. We are not named on anything your client sees. Where a document needs your branding, it carries your branding.',
  },
  {
    n: '05',
    t: 'We hand it over, and we hand over the method',
    d: 'Not just a result. You get the runbook, the checklist and the walkthrough, so the next time it is your own team doing it. We would rather be called back twice a year than relied on permanently.',
  },
];

const handover = [
  { t: 'Findings', d: 'Written findings separated into what was observed and what we infer from it, with severity, evidence and a concrete fix for each.' },
  { t: 'Runbooks', d: 'The operating procedures we actually used, written for your team to run and maintain — not a summary of them.' },
  { t: 'Code and configuration', d: 'Version-controlled infrastructure definitions and any scripts, with the history that shows what changed and why.' },
  { t: 'Evidence', d: 'The control inventory, the evidence pack and the record of what was tested and when — so the next audit starts from a baseline rather than from scratch.' },
  { t: 'A walkthrough', d: 'A live session with your engineers, recorded on request, so the knowledge sits with the people who will maintain it.' },
];

const weNeed = [
  'A statement of work or a scope you are willing to have us challenge.',
  'Named access, granted by your client in their own account, with the permissions the work needs and nothing more.',
  'A technical contact on your side who can answer questions within a working day.',
  'Your escalation path, in writing, before we start — including what your client should hear if something goes wrong.',
  'Agreement on how the work is invoiced between us: per project, per month, or on your client’s payment terms.',
];

const never = [
  { t: 'We never contact your client', d: 'Not for sales, not for a reference, not for a case study, and not to ask for a review. If your client asks us directly, we refer them to you.' },
  { t: 'We are never named on your client’s invoice', d: 'You are their supplier. We are your subcontractor. That relationship is yours and we do not compete for it.' },
  { t: 'We never hold credentials we cannot revoke', d: 'All access lives in your client’s account. No shared logins, no exported keys, no long-lived access keys sitting in our tooling.' },
  { t: 'We never take a percentage of your client’s payment', d: 'We invoice you, at a fixed wholesale rate. If your client pays you more, the difference is yours. We are not taking a cut of your revenue.' },
  { t: 'We never expand the scope without telling you', d: 'If we find something outside the agreed scope, we price it separately and ask you first. We do not quietly add hours to your project.' },
  { t: 'We never sell to your client around you', d: 'If your client wants to engage us directly later, that is a conversation we have with you first. We do not go around a partner who introduced us.' },
];
---

<BaseLayout
  title="Partner with us"
  description="White-label cloud, security and managed-operations engineering for MSPs. You keep the client, the credit and the margin. Fixed scope, published wholesale pricing, work done in your client's own account."
>
  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CAVELDON partner delivery',
    serviceType: 'White-label cloud and security engineering delivery',
    description: 'Fixed-scope cloud, security, managed infrastructure and reliability work delivered on behalf of an MSP, in the MSP\'s name, in the end client\'s own cloud account.',
    audience: { '@type': 'BusinessAudience', name: 'Managed service providers' },
    provider: { '@type': 'ProfessionalService', name: 'CAVELDON' },
  }} />

  <section class="band page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Partner</span></nav>
      <p class="eyebrow">For MSPs</p>
      <h1>The bench behind your bench.</h1>
      <p class="lead">
        You keep the client, the credit and the margin. We do the delivery, in your
        name, in your client’s own account. Fixed scope, fixed price, and a wholesale
        rate you can see before you commit.
      </p>
      <div class="actions" style="margin-top:28px">
        <a class="btn btn-solid" href="/contact/#form">Discuss a partnership <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#pricing">See the wholesale pricing <span class="arr" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="situations-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">When this is useful</p>
          <h2 id="situations-title">Four situations where MSPs bring us in.</h2>
        </div>
        <p class="intro">
          We are not a helpdesk, a SOC you can point at, or a ticket queue. We are
          engineering delivery for the engagements that need a specialist and a
          deadline.
        </p>
      </div>

      <div class="cells cols-2">
        {situations.map(s => (
          <article class="svc">
            <h3>{s.t}</h3>
            <p class="promise">{s.d}</p>
            <p class="track-sub"><b>How we fit:</b> {s.fit}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="how-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">How it runs</p>
          <h2 id="how-title">Five steps, from scope to handover.</h2>
        </div>
        <p class="intro">
          Nothing here is unusual, and that is the point. A delivery partner you have
          to learn is not saving you anything.
        </p>
      </div>

      <ol class="numbered">
        {steps.map(s => (
          <li>
            <span>
              <strong style="color:var(--ink)">{s.t}</strong><br />
              {s.d}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="handover-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What you get back</p>
          <h2 id="handover-title">Five things, every time.</h2>
        </div>
        <p class="intro">
          These are the deliverables on every engagement, whether you bought it
          directly or through a partner. They carry your name, not ours.
        </p>
      </div>

      <div class="cells cols-2">
        {handover.map(h => (
          <article class="svc">
            <h3>{h.t}</h3>
            <p class="promise">{h.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="pricing" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Pricing</p>
          <h2 id="pricing-title">What you pay, and what you keep.</h2>
        </div>
        <p class="intro">
          Wholesale is {rate}% of our published price on every engagement. You set the
          price to your client. If you resell at our list, that is the margin you keep.
        </p>
      </div>

      <div class="partner-prices">
        <table class="price-table">
          <caption class="sr-only">CAVELDON wholesale pricing for MSP partners</caption>
          <thead>
            <tr>
              <th scope="col">Engagement</th>
              <th scope="col">Our list price</th>
              <th scope="col">Your wholesale price</th>
              <th scope="col">Your margin at list</th>
            </tr>
          </thead>
          <tbody>
            {engagements.map(e => (
              <tr>
                <th scope="row">
                  {e.name}
                  <span class="price-shape">{e.per}</span>
                </th>
                <td>{e.amount}</td>
                <td class="price-whole">{wholesale(e)}{e.recurring ? '/mo' : ''}</td>
                <td class="price-margin">{partnerMargin(e)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="price-note" style="margin-top:24px">
        <b>How the money works:</b> we invoice you, at the wholesale price, on the
        schedule in the agreement. We do not take a percentage of what your client
        pays you. If a piece of work needs a scope we do not have on this list, we
        quote it to you first, at a wholesale rate, before you quote it to your client.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="need-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Starting</p>
          <h2 id="need-title">What we need from you to begin.</h2>
        </div>
        <p class="intro">
          Five things. If any of them is a problem, say so on the first call — it is
          much easier to solve then than in week two.
        </p>
      </div>

      <ol class="numbered">
        {weNeed.map(w => (
          <li><span>{w}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="never-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">The commitments</p>
          <h2 id="never-title">Six things we will never do.</h2>
        </div>
        <p class="intro">
          You are trusting us with your client’s account and your reputation. These
          are the lines we do not cross, written down so you can hold us to them.
        </p>
      </div>

      <div class="cells cols-2">
        {never.map(n => (
          <article class="svc">
            <h3>{n.t}</h3>
            <p class="promise">{n.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock
    title="Start with something small and real"
    text="The first partner engagement is usually one scoped piece of work with a fixed price and a handover your team can keep. Send us the scope and we will tell you honestly whether we are the right bench for it."
  />
</BaseLayout>
