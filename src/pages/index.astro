---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/BookButton.astro';
import HeroDiagram from '../components/diagrams/HeroDiagram.astro';
import Founder from '../components/Founder.astro';
import CtaBlock from '../components/CtaBlock.astro';
import FitSection from '../components/FitSection.astro';
import Engagements from '../components/Engagements.astro';
import StartHere from '../components/StartHere.astro';
import HowWeWork from '../components/HowWeWork.astro';
import SignalStrip from '../components/SignalStrip.astro';
import TwoTracks from '../components/TwoTracks.astro';
import Segments from '../components/Segments.astro';
import PracticeIcon from '../components/PracticeIcon.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, isLive } from '../data/site';
import { homeFaqs } from '../data/faq';
import { studies } from '../data/work.js';
import { visibleInsights } from '../lib/content';
import { faqSchema } from '../lib/schema';

const posts = (await visibleInsights()).slice(0, 2);
const offer = site.offer;

// Launch check: printed during `npm run build` when PUBLIC_SITE_LIVE=true and something visitors need is missing.
if (isLive) {
  const f = site.founder, env = import.meta.env;
  const missing = [
    !f.name && 'founder.name', !f.bio && 'founder.bio',
    !f.experience && 'founder.experience',
    !env.PUBLIC_SITE_URL && 'PUBLIC_SITE_URL',
    (!env.PUBLIC_CONTACT_EMAIL && !(env.PUBLIC_CONTACT_API_URL && env.PUBLIC_TURNSTILE_SITE_KEY)) && 'a working contact channel (email or API + Turnstile)',
    (await visibleInsights()).length === 0 && 'at least one article with draft: false',
  ].filter(Boolean);
  if (missing.length) throw new Error(`[CAVELDON launch blocked] Configure and verify: ${missing.join(', ')}`);
}

// Entry points are common needs, not claims that a visitor has a particular problem.
const moments = [
  { n: '01', tag: 'Establish', q: 'You need an environment set up, and you know the code but not the infrastructure.', a: 'One application, one environment, on AWS or Azure — networking, access, deployment, backups, monitoring, and a handover your developers can follow.', href: '/setup/', go: 'Cloud setup for small teams' },
  { n: '02', tag: 'Protect', q: 'A customer, an auditor or an insurer needs proof you can control.', a: 'Make access, configuration controls, logging and technical evidence easier to manage — and much easier to show.', href: '/soc-2/', go: 'Security and governance readiness' },
  { n: '03', tag: 'Operate', q: 'Somebody has to own the servers, the patching and the helpdesk.', a: 'Put patching, monitoring, backups and support on a documented schedule with named ownership.', href: '/services/#managed', go: 'Managed infrastructure and support' },
  { n: '04', tag: 'Improve', q: 'The cloud bill has grown faster than your understanding of it.', a: 'Measure usage, evaluate architecture trade-offs, and find savings that do not quietly move the failure mode.', href: '/services/#cost', go: 'Cost and reliability engineering' },
  { n: '05', tag: 'Resell', q: 'You are an MSP and you have won work you cannot staff.', a: 'We deliver it in your name, in your client’s own account, at a wholesale rate. You keep the client and the margin.', href: '/partner/', go: 'Partner with us' },
  { n: '06', tag: 'Understand', q: 'You would rather work it out yourself first.', a: 'The checklist we work from, free and printable. If it shows you are fine, you do not need us.', href: '/checklist/', go: 'The free checklist' },
];

// Four service families. Individual capabilities remain on the Services page.
const services = [
  { id: 'setup', p: 1, title: 'Cloud, Platform & Product Engineering', promise: 'Build the thing, and the platform it runs on.', items: ['Cloud setup, application and database migration', 'Platform architecture across AWS and Azure', 'Software, API and application engineering', 'Infrastructure automation and deployment'] },
  { id: 'security', p: 2, title: 'Security, Governance & Compliance Readiness', promise: 'Controls that can be understood and examined.', items: ['Identity, access, encryption and cloud guardrails', 'Data protection, logging and configuration evidence', 'Technical control remediation and audit preparation'] },
  { id: 'managed', p: 3, title: 'Managed Infrastructure & Support', promise: 'Your estate looked after, on a schedule.', items: ['Managed servers, patching and lifecycle management', 'Monitoring, alerting and documented response', 'Backup restore drills with recorded recovery times'] },
  { id: 'reliability', p: 4, title: 'Reliability, Performance & FinOps', promise: 'Systems that are easier to run and improve.', items: ['Observability, incident and recovery readiness', 'Performance, capacity and operational practices', 'Cloud cost visibility and efficiency improvements'] },
];
---
<BaseLayout title="home" description="CAVELDON helps growing software businesses design, modernize, secure, govern and improve cloud infrastructure across AWS and Azure.">
  <JsonLd data={faqSchema(homeFaqs)} />

  <!-- 1. HERO — full-bleed dark band -->
  <section class="band hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow rise">Cloud &amp; operational engineering · AWS + Azure</p>
        <h1 id="hero-title" class="rise">Cloud systems your business can depend on.</h1>
        <p class="lead rise rise-2">We design, modernize, secure, run and improve cloud infrastructure across AWS and Azure. CAVELDON is <b>one accountable engineer</b> — a decade across hosting, support, DevOps, SRE, security, cost and governance means the whole system gets looked at, not just the part you called about.</p>
        <div class="actions rise rise-2">
          <BookButton />
          <a class="btn btn-ghost" href="/services/">Explore our services <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <ul class="ticks rise rise-3">
          <li>AWS and Azure engineering</li>
          <li>One engineer who has run every layer</li>
          <li>Clear decisions, practical handover</li>
        </ul>
        <p class="hero-note rise rise-3">
          Why one engineer is the cheaper option — the seams where cloud systems
          actually fail: <a class="link" href="/experience/">every layer, from the inside <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <HeroDiagram />
    </div>
  </section>

  <!-- 1b. SIGNAL STRIP -->
  <div class="wrap" style="padding-top:clamp(28px,4vw,44px)">
    <SignalStrip />
  </div>

  <!-- 2. SELF-RECOGNITION: where are you right now? -->
  <section class="section" id="moments" aria-labelledby="moments-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Start where you are</p>
          <h2 id="moments-title">Six ways in, and the one that fits you.</h2>
        </div>
        <p class="intro">Each one is a separate page with its own scope, its own price and nothing you have to read twice. No technical terminology required.</p>
      </div>
      <div class="cells cols-2">
        {moments.map(m => (
          <a class="pain" href={m.href}>
            <span class="cell-num">{m.n} · {m.tag.toUpperCase()}</span>
            <h3>{m.q}</h3>
            <p class="fix">{m.a}</p>
            <span class="go">{m.go} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. WHAT WE DO -->
  <section class="section section--alt" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="services-title">Four connected engineering practices.</h2>
        </div>
        <p class="intro">Cloud architecture, security controls, managed operations and day-to-day support affect one another. Our services bring these decisions together without turning every project into a large transformation. <a class="link" href="#two-tracks">Two ways to buy this — directly, or through your MSP <span aria-hidden="true">↓</span></a></p>
      </div>
      <div class="cells cols-2">
        {services.map((s, i) => (
          <article class={`svc practice p-${s.p}`}>
            <div class="svc-top"><PracticeIcon practice={s.p as 1|2|3|4} size={40} /><span class="label">AWS · AZURE</span></div>
            <h3>{s.title}</h3>
            <p class="promise">{s.promise}</p>
            <ul class="bullets">{s.items.map(x => <li>{x}</li>)}</ul>
            <a class="link" href={`/services/#${s.id}`}>Explore this practice <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <p class="aside-note" style="margin-top:24px"><span class="label">Developing in the Lab</span> We are also exploring AI infrastructure engineering through reference implementations. <a class="link" href="/services/#ai">See this developing capability →</a></p>
    </div>
  </section>

  <!-- 4. TWO WAYS TO WORK WITH US -->
  <TwoTracks />

  <!-- 5. HOW IT WORKS -->
  <HowWeWork />

  <!-- 6. STARTING ENGAGEMENTS -->
  <Engagements />

  <!-- 7. WHAT YOU GET -->
  <section class="section" id="report" aria-labelledby="report-title">
    <div class="wrap report-grid">
      <div>
        <p class="eyebrow">What you get</p>
        <h2 id="report-title">Engineering findings that people can act on.</h2>
        <p class="intro" style="margin-top:18px">A good engineering review separates observation from inference, explains technical risks in plain language and makes the next decision easier.</p>
        <ul class="bullets" style="margin-top:24px">
          <li>Findings across security, reliability, cost and scale</li>
          <li>Fix and effort estimate for each</li>
          <li>A prioritized improvement roadmap</li>
          <li>A findings walkthrough when included in the agreed scope</li>
        </ul>
      </div>
      <figure class="frame report" style="margin:0">
        <div class="frame-cap"><span>Sample · {offer.name}</span><span>Illustrative examples</span></div>
        <div class="finding">
          <span class="sev sev-high">HIGH</span>
          <div><h4>Only one engineer can deploy or access production.</h4><p><b>Area</b>Due diligence · key-person risk</p><p><b>Fix</b>Pipeline-only deploys, documented runbooks, named access for two or more people.</p></div>
          <div class="effort"><span>EFFORT</span>3–4 days</div>
        </div>
        <div class="finding">
          <span class="sev sev-high">HIGH</span>
          <div><h4>Five people share one admin login. MFA isn’t enforced.</h4><p><b>Area</b>Security · SOC 2 CC6.1</p><p><b>Fix</b>Single sign-on and MFA; named access roles; remove the shared login.</p></div>
          <div class="effort"><span>EFFORT</span>2–3 days</div>
        </div>
        <div class="finding">
          <span class="sev sev-med">MEDIUM</span>
          <div><h4>Database backups have never been restored in a test.</h4><p><b>Area</b>Reliability · SOC 2 A1.3</p><p><b>Fix</b>Scheduled restore test with recorded results and an alert on failure.</p></div>
          <div class="effort"><span>EFFORT</span>~1 day</div>
        </div>
        <div class="finding">
          <span class="sev sev-med">MEDIUM</span>
          <div><h4>GPU instances run 24/7 for a feature used in office hours.</h4><p><b>Area</b>Cost · AI workloads</p><p><b>Fix</b>Scale to zero outside peak hours; move batch jobs to cheaper capacity.</p></div>
          <div class="effort"><span>EFFORT</span>~2 days</div>
        </div>
        <figcaption class="report-foot">Illustrative example of the report format. Not from a real client.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 8. WHO YOU'LL WORK WITH -->
  <section class="section" id="founder" aria-labelledby="founder-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Who you’ll work with</p>
          <h2 id="founder-title">Founder-led, engineering-first.</h2>
        </div>
        <p class="intro">CAVELDON is a founder-led engineering practice. The people responsible for an engagement, the technical scope and the handover arrangements should always be clear before work begins.</p>
      </div>
      <Founder />
      <div class="cells cols-3 principles">
        <div><span class="cell-num">CLARITY</span><h3>Problem before solution</h3><p>We explain what’s wrong and the options before changing anything.</p></div>
        <div><span class="cell-num">EVIDENCE</span><h3>No made-up claims</h3><p>We say what’s been tested, what hasn’t, and what still needs proof.</p></div>
        <div><span class="cell-num">OWNERSHIP</span><h3>Built to hand over</h3><p>The goal is documented, reviewable changes that your team can understand and maintain.</p></div>
      </div>
    </div>
  </section>

  <!-- 9. WHO THIS FITS, BY SIZE -->
  <Segments />

  <!-- 10. IS THIS FOR YOU -->
  <FitSection />

  <!-- 11. SEE HOW WE THINK -->
  <section class="section section--alt" aria-labelledby="think-title">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">See how we think</p>
        <h2 id="think-title">Engineering thinking, made visible.</h2>
        <p class="intro" style="margin-top:18px">Explore reference designs that explain architecture decisions and proposed validation. They are illustrative studies, not client implementations.</p>
        <a class="link" style="margin-top:24px" href="/work/">Explore the Engineering Lab <span aria-hidden="true">→</span></a>
      </div>
      <div class="rows">
        {studies.map(s => (
          <a class="row" href={`/work/${s.slug}/`}>
            <span class="cell-num">{s.number}</span>
            <div><h3>{s.title}</h3><p>{s.category}</p></div>
            <span class="arr" aria-hidden="true">→</span>
          </a>
        ))}
        {posts.map(p => (
          <a class="row" href={`/insights/${p.id}/`}>
            <span class="cell-num">GUIDE</span>
            <div><h3>{p.data.title}</h3><p>{p.data.readMinutes} min read</p></div>
            <span class="arr" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. START HERE -->
  <StartHere />

  <!-- 13. FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Common questions before starting.</h2>
        <p class="intro" style="margin-top:18px">Have a question that is not covered? The Contact page is a simple place to start.</p>
      </div>
      <div class="faq">
        {homeFaqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="answer">{f.a.map(t => <p>{t}</p>)}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock />
</BaseLayout>
