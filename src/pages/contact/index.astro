---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLive, bookIsExternal, bookHref } from '../../data/site';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbSchema } from '../../lib/schema';
// These are intentionally PUBLIC values. Secrets must NEVER appear in Astro's PUBLIC_ env vars.
const endpoint = (import.meta.env.PUBLIC_CONTACT_API_URL || '').trim();
const siteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim();
const contactEmail = (import.meta.env.PUBLIC_CONTACT_EMAIL || '').trim();
const ready = Boolean(endpoint && siteKey);
// On a live site the form only appears once the email backend is configured. Until then: email (and calendar) instead.
const showForm = ready || !isLive;
---
<BaseLayout title="Contact" description="Contact CAVELDON about AWS or Azure infrastructure, cloud security and governance, reliability and cost efficiency. No technical brief required.">
  <JsonLd data={breadcrumbSchema([{ name: 'Contact', path: '/contact/' }])} />
  <section class="page-hero gridpaper">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Contact</span></nav>
      <p class="eyebrow">Contact</p>
      <h1>Let’s talk about your cloud.</h1>
      <p class="lead">Tell us what you are building or what needs improving. You do not need to know the technical solution. Use the inquiry form or a calendar link when available.</p>
    </div>
  </section>

  <section class="section" aria-label="Ways to get in touch">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">What happens next</p>
        <ol class="numbered">
          <li><span><strong style="color:var(--ink)">You book a time or send a message.</strong> Describe the problem in everyday language.</span></li>
          <li><span><strong style="color:var(--ink)">We review the request</strong> and respond based on fit and availability.</span></li>
          <li><span><strong style="color:var(--ink)">An initial conversation.</strong> We discuss the situation, what needs verifying and possible next steps. No pressure.</span></li>
        </ol>

        {bookIsExternal ? (
          <div class="frame book-card">
            <span class="label">Prefer to pick a time?</span>
            <h3>Choose a time to talk</h3>
            <p>Choose a slot that suits your time zone.</p>
            <div class="actions" style="margin-top:18px"><a class="btn btn-solid" href={bookHref} target="_blank" rel="noopener">Open the calendar <span class="arr" aria-hidden="true">↗</span></a></div>
          </div>
        ) : !isLive && (
          <div class="frame book-card">
            <span class="label">Booking calendar</span>
            <p style="margin-top:8px"><span class="ph">[Set PUBLIC_BOOKING_URL to a Cal.com or Calendly link to show a “pick a time” button here]</span></p>
          </div>
        )}

        {contactEmail && showForm && <p style="margin-top:28px"><span class="label">Prefer email?</span><br/><a class="link" href={`mailto:${contactEmail}`}>{contactEmail}</a></p>}
        <p class="callout" style="margin-top:28px"><strong>Need an NDA first?</strong> Mention that in your inquiry. We can discuss confidentiality terms before you share restricted details.</p>
      </div>

      {showForm ? (
      <div class="frame form-panel" id="form">
        <div class="frame-cap"><span>Message</span><span>Short inquiry</span></div>
        <h2>Send a message</h2>
        <p class:list={['mode', ready && 'is-ready']} id="contact-mode" aria-live="polite">{ready ? 'Online and monitored' : 'Prelaunch · messages are not sent yet'}</p>
        <form id="contact-real-form" data-endpoint={ready ? endpoint : ''} data-sitekey={ready ? siteKey : ''} novalidate>
          <div class="field-row">
            <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" required minlength="2" maxlength="90" /></div>
            <div class="field"><label for="c-email">Work email</label><input id="c-email" name="email" type="email" autocomplete="email" required maxlength="180" placeholder="you@company.com" /></div>
          </div>
          <div class="field"><label for="c-service">What’s it about?</label>
            <select name="service" id="c-service" required>
              <option value="" selected disabled>Choose one</option>
              <option value="cloud">Cloud & platform engineering (AWS / Azure)</option>
              <option value="migration">Cloud migration &amp; modernization</option>
              <option value="security">Security, governance &amp; audit readiness</option>
              <option value="reliability">Reliability, operations &amp; FinOps</option>
              <option value="ai">AI infrastructure (developing)</option>
              <option value="unsure">Not sure / another cloud question</option>
            </select>
          </div>
          <div class="field"><label for="c-message">What’s going on?</label>
            <textarea id="c-message" name="message" required minlength="20" maxlength="2000" rows="5" placeholder="e.g. We are moving our application and database from existing hosting to the cloud. We need help planning access, downtime, testing and the move itself."></textarea>
            <span class="hint">A few sentences is plenty. Please don’t include passwords, keys or customer data.</span>
          </div>
          <div class="honeypot" aria-hidden="true"><label for="c-website">Website (leave blank)</label><input id="c-website" name="companyWebsite" tabindex="-1" autocomplete="off" /></div>
          <label class="consent"><input type="checkbox" name="consent" id="c-consent" required /><span>{ready ? <>I agree that CAVELDON can use these details to reply to me under the <a href="/privacy/">privacy notice</a>. I haven’t included any sensitive information.</> : <>I confirm this message contains no passwords, keys or sensitive data. See the <a href="/privacy/">privacy notice</a>.</>}</span></label>
          {ready && <div class="turnstile" aria-label="Spam protection"><div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div></div>}
          <button class="btn btn-solid" type="submit" id="c-submit">{ready ? 'Send message' : 'Copy message draft'} <span class="arr" aria-hidden="true">→</span></button>
          <p id="contact-feedback" class="feedback" role="status" aria-live="polite"></p>
          <p class="footnote">{ready ? 'Sent to our inbox by email. We don’t store messages in a database.' : 'Prelaunch preview: this form doesn’t send or store anything yet. It copies your message so you can paste it into an email.'}</p>
        </form>
      </div>
      ) : (
      <div class="frame form-panel" id="form">
        <div class="frame-cap"><span>Email</span><span>Email contact</span></div>
        <h2>Email us</h2>
        {contactEmail
          ? <p style="margin-top:14px;font-size:20px"><a class="link" href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
          : <p class="callout" style="margin-top:14px">Set PUBLIC_CONTACT_EMAIL or PUBLIC_BOOKING_URL before launch, or visitors have no way to reach you.</p>}
        <p style="margin-top:16px;color:var(--ink-2)">Tell us your stage and what’s pushing you, and suggest a couple of times that suit you. Please don’t include passwords, keys or customer data.</p>
        {bookIsExternal && <div class="actions"><a class="btn btn-solid" href={bookHref} target="_blank" rel="noopener" data-track="Book call">Or pick a time in the calendar <span class="arr" aria-hidden="true">↗</span></a></div>}
      </div>
      )}
    </div>
  </section>
  {ready && <script is:inline defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
  <script is:inline defer src="/contact.js"></script>
</BaseLayout>
