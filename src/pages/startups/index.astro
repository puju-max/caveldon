---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookButton from '../../components/BookButton.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site } from '../../data/site';
import { startupFaqs } from '../../data/faq';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';
const offer = site.offer;

const foundation = [
  'Company-owned cloud environments, not personal accounts',
  'Separate production and test environments',
  'Single sign-on with MFA for everyone',
  'Infrastructure as code from the first resource',
  'An automated deployment pipeline with rollback',
  'Backups, restored once to prove they work',
  'Basic monitoring and alerts that reach a person',
  'Budget alerts, so a mistake can’t burn your credits overnight',
];

const dd = [
  { area: 'Security', ask: 'Who can access customer data? Have you ever had an incident?', prep: 'Named access with MFA, logging, encryption, and a one-page security overview you can share.' },
  { area: 'Scalability', ask: 'What breaks at 10× your current traffic?', prep: 'An architecture diagram, load-test results, known limits and the plan for each.' },
  { area: 'Cloud cost', ask: 'What does the platform cost per customer, and how will that change?', prep: 'Costs broken down by environment and product, a unit-cost estimate, and quick savings made.' },
  { area: 'Key-person risk', ask: 'What happens if your lead engineer leaves?', prep: 'Infrastructure as code, pipeline-only deploys, runbooks, and more than one person with access.' },
  { area: 'Ownership', ask: 'Does the company own its code, cloud accounts and domains?', prep: 'Company-owned cloud, source code and domain accounts, with former contractors’ access removed.' },
  { area: 'Reliability', ask: 'How often is the product down, and how fast do you recover?', prep: 'Uptime monitoring, an incident log, and a tested recovery time.' },
];

const stages = [
  { tag: 'Launch', title: 'Set up the cloud right from day one', href: '#launch' },
  { tag: 'Raise', title: 'Get ready for technical due diligence', href: '#fundraising' },
  { tag: 'Sell', title: 'Prepare for enterprise security reviews and SOC 2', href: '/soc-2/' },
  { tag: 'Scale', title: 'Stay up and keep the bill under control', href: '/services/#reliability' },
  { tag: 'Add AI', title: 'Run AI features reliably and affordably', href: '/services/#ai' },
];
---
<BaseLayout title="Cloud & DevOps for startups" description="Cloud setup for startups, and readiness for investors' technical due diligence: security, scalability, cloud cost, key-person risk and ownership. Engagement scope and terms agreed in advance.">
  <JsonLd data={[
    breadcrumbSchema([{ name: 'Startups', path: '/startups/' }]),
    serviceSchema('Cloud setup and fundraising readiness for startups', 'Cloud setup for early-stage startups and preparation for investors’ technical due diligence.', '/startups/'),
    faqSchema(startupFaqs),
  ]} />

  <section class="page-hero gridpaper">
    <div class="wrap page-hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Startups</span></nav>
        <p class="eyebrow">For startups</p>
        <h1>Launch on solid ground. Raise with confidence.</h1>
        <p class="lead">Get your cloud set up properly from day one, and ready for the questions investors ask in technical due diligence. Planned for your current needs, with room to improve as you grow.</p>
        <div class="actions"><BookButton /><a class="btn btn-ghost" href="#fundraising">What investors check <span class="arr" aria-hidden="true">↓</span></a></div>
      </div>
      <aside class="frame answer-box" aria-label="Short answer">
        <div class="frame-cap"><span>Short answer</span><span>What investors check</span></div>
        <p>In technical due diligence, investors usually look at five things:</p>
        <p><strong>Is it secure? Can it scale? What does it cost? Can more than one person run it? Does the company own it?</strong></p>
        <p>A good cloud setup answers all five before anyone asks.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="launch" aria-labelledby="launch-title">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Launching</p>
        <h2 id="launch-title">The startup cloud foundation.</h2>
        <p class="intro" style="margin-top:18px">Eight things that take little time at the start and months to fix later. These can be reviewed and scoped as a defined engineering engagement.</p>
        <div class="actions"><BookButton size="sm" label="Plan our setup" /></div>
      </div>
      <ul class="checks done" style="border-top:1px solid var(--line-2)">{foundation.map(x => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="section section--alt" id="fundraising" aria-labelledby="dd-title">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">Raising a round</p><h2 id="dd-title">What investors ask, and what we prepare.</h2></div>
        <p class="intro">Technical due diligence is most common from Series A onwards. Being ready makes the process faster and gives investors fewer reasons to hesitate.</p>
      </div>
      <div class="ctl ctl-3" role="table" aria-label="Technical due diligence areas">
        <div class="ctl-row ctl-head" role="row"><span role="columnheader">Area</span><span role="columnheader">What investors ask</span><span role="columnheader">What we prepare</span></div>
        {dd.map(d => (
          <div class="ctl-row" role="row">
            <h3 role="rowheader">{d.area}</h3>
            <p role="cell"><span class="ctl-k">Investors ask</span>{d.ask}</p>
            <p role="cell"><span class="ctl-k">We prepare</span>{d.prep}</p>
          </div>
        ))}
      </div>
      <p class="caveat">Every investor runs due diligence differently, and it also covers areas outside engineering. This covers the cloud and engineering side. The {offer.name} shows where you stand before you start fundraising.</p>
    </div>
  </section>

  <section class="section" id="team" aria-labelledby="team-title">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Until you hire</p>
        <h2 id="team-title">Continuing cloud engineering support.</h2>
      </div>
      <div>
        <p class="intro">Most startups need DevOps skills long before they can justify a full-time hire. If ongoing help would be useful, we can discuss the scope, capacity and handover expectations rather than assuming a fixed monthly arrangement.</p>
        <p style="margin-top:20px"><a class="link" href="/services/#team">Discuss ongoing support <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="stages-title">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">As you grow</p>
        <h2 id="stages-title">Cloud requirements change with your stage.</h2>
        <p class="intro" style="margin-top:18px">Related cloud engineering work may span several stages, from initial setup to greater operational maturity.</p>
      </div>
      <div class="rows">
        {stages.map(s => (
          <a class="row" href={s.href}>
            <span class="cell-num">{s.tag.toUpperCase()}</span>
            <div><h3>{s.title}</h3></div>
            <span class="arr" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Startup questions</p>
        <h2 id="faq-title">What founders ask us.</h2>
      </div>
      <div class="faq">
        {startupFaqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="answer">{f.a.map(t => <p>{t}</p>)}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock title="Raising soon, or just launched?" text="Tell us your stage and technical constraints. We can discuss what a targeted engineering review might cover." />
</BaseLayout>
