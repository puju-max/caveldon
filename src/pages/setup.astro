---
/**
 * Cloud setup for teams that know the code, not the infrastructure.
 *
 * This is the entry point for the segment the rest of the site under-serves:
 * a one-to-five person team, or a technical founder, who can ship software and
 * has never had to run a server, provision a network, write an IAM policy or
 * read a cloud bill.
 *
 * The honest framing matters here. That person does not want a "platform
 * team" and does not need one. They need somebody to set the environment up
 * correctly once, document it, and hand it over. That is a small, fixed-scope
 * job with a price on it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { engagements } from '../data/pricing';

const setup = engagements.find(e => e.name === 'Cloud Setup & Handover')!;
const managed = engagements.find(e => e.name === 'Managed Infrastructure & Support')!;

const symptoms = [
  'The deployment is a command someone typed once and nobody has repeated since.',
  'Nobody can say what the server\'s permissions actually allow.',
  'The database is a backup that has never been restored.',
  'Production, staging and local all run against different configurations, and you find out which one you are on at runtime.',
  'The cloud bill arrived and nobody can explain a line of it.',
  'The one person who set it up has moved on, and the setup lives in their head.',
];

const includes = [
  {
    t: 'The environment',
    d: 'Network, subnets, DNS, identity, compute, storage and secrets — provisioned as code, so the next environment is a command rather than an afternoon.',
    b: 'Two accounts, separate from your own, with the boundary drawn on purpose.',
  },
  {
    t: 'Access',
    d: 'Roles and policies for a small team, with no standing admin and no shared credentials. Every permission has a name attached to it.',
    b: 'A written list of who can do what, which your client’s auditors can read.',
  },
  {
    t: 'The deployment path',
    d: 'One path from a commit to production, with build, test, approval and rollback. It runs the same way twice, which is the point.',
    b: 'A rollback that has actually been executed once, not just written down.',
  },
  {
    t: 'Data and backups',
    d: 'Backups configured, retention set, and one restore performed in a test environment so you know the time it takes and that it works.',
    b: 'A recorded restore time, not a promise that backups exist.',
  },
  {
    t: 'Visibility',
    d: 'Enough monitoring to know the thing is up and roughly healthy, with alerts routed to a person who will actually look.',
    b: 'No dashboard nobody opens. Alerts that map to something to do.',
  },
  {
    t: 'The handover',
    d: 'A written document that says what exists, why it was built that way, what breaks it, and what to do when it breaks.',
    b: 'Written so a developer who has never seen it can operate it.',
  },
];

const aws = {
  t: 'AWS',
  d: 'The wider service catalogue, the deepest third-party tooling, and the largest pool of people who already know it. Managed container and serverless options are genuinely strong.',
  best: [
    'You want the widest set of managed services to choose from.',
    'You are hiring, and most of the market knows AWS.',
    'Your workload is containers, serverless, or a data pipeline.',
  ],
  watch: [
    'The cost model has more ways to surprise you. NAT gateways, cross-AZ traffic and idle load balancers are the usual three.',
    'The IAM model is powerful and unforgiving. It needs deliberate design, not defaults.',
  ],
};

const azure = {
  t: 'Azure',
  d: 'Tighter identity integration when your people already live in Entra ID, a smoother path for Windows and hybrid estates, and a generally less surprising cost shape for straightforward workloads.',
  best: [
    'Your team and your directory are already in Microsoft 365 / Entra ID.',
    'You have Windows servers or an on-premises estate you are not replacing yet.',
    'Your compliance requirements map onto Microsoft’s own tooling and audit features.',
  ],
  watch: [
    'There are overlapping services with similar names, and picking the wrong one is a common and expensive mistake.',
    'Networking defaults need understanding before they are extended.',
  ],
};

const notFor = [
  'You need a team. A one-to-five person team does not need a platform team, and we are not one.',
  'You want someone to carry the pager. Business-hours support is a separate engagement; 24/7 staffed operations is a different business.',
  'You want us to certify you. We build the controls and the evidence. Auditors and accrediting bodies issue the report.',
  'You want us to write your application. This is infrastructure. We will point out where your code is the problem, and we will not rewrite it for you.',
];
---

<BaseLayout
  title="Cloud setup for small teams"
  description="Set up a small cloud environment on AWS or Azure for a team that knows the code but not the infrastructure. Fixed scope, fixed price, documented handover. No long-term contract."
>
  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Cloud Setup & Handover',
    description: 'A small cloud environment set up on AWS or Azure — networking, identity, compute, storage, deployment, backups, monitoring — with a documented handover.',
    serviceType: 'Cloud environment setup',
    provider: { '@type': 'ProfessionalService', name: 'CAVELDON' },
    areaServed: ['Worldwide'],
    offers: { '@type': 'Offer', price: setup.amount.replace('$', ''), priceCurrency: 'USD' },
  }} />

  <section class="band page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Cloud setup</span></nav>
      <p class="eyebrow">For small teams</p>
      <h1>You write the code. We set up the cloud it runs on.</h1>
      <p class="lead">
        For a one-to-five person team, or a founder who has shipped software and never
        had to provision a network. One environment, set up properly, documented, and
        handed over. <b>{setup.amount}</b> — {setup.per}.
      </p>
      <div class="actions" style="margin-top:28px">
        <a class="btn btn-solid" href="/contact/#form">Start a setup <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#checklist">See the checklist first <span class="arr" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="recognise-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Does this sound like you</p>
          <h2 id="recognise-title">Six sentences we have heard before.</h2>
        </div>
        <p class="intro">
          If any of these are true, the problem is not that you need to learn
          infrastructure. It is that nobody has had time to set it up properly.
          That is a job, and it has a price.
        </p>
      </div>

      <ul class="checklist-list">
        {symptoms.map(s => (
          <li>
            <span class="check-mark" aria-hidden="true"></span>
            <span>{s}</span>
          </li>
        ))}
      </ul>

      <p class="aside-note" style="margin-top:28px">
        <span class="label">And the thing nobody says</span>
        The most common reason this is urgent is not a technical failure. It is a
        security questionnaire, a customer audit, or a due-diligence request where
        somebody has to answer for the environment and nobody can.
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="includes-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">The scope</p>
          <h2 id="includes-title">What a setup actually includes.</h2>
        </div>
        <p class="intro">
          Six pieces of work, in this order. One application, one environment. If your
          situation does not fit inside that, we will say so on the first call rather
          than halfway through.
        </p>
      </div>

      <div class="cells cols-2">
        {includes.map(i => (
          <article class="svc">
            <h3>{i.t}</h3>
            <p class="promise">{i.d}</p>
            <p class="track-sub"><b>What you get:</b> {i.b}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cloud-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">AWS or Azure</p>
          <h2 id="cloud-title">We work on both. Here is the honest difference.</h2>
        </div>
        <p class="intro">
          Both are good platforms and neither is a trap. The wrong choice is picking
          one because it was the default in the tutorial you followed. These are the
          trade-offs that actually decide it for a small team.
        </p>
      </div>

      <div class="cloud-compare">
        {[aws, azure].map(c => (
          <article class="cloud-card">
            <h3>{c.t}</h3>
            <p class="promise">{c.d}</p>
            <span class="label">Choose it when</span>
            <ul class="bullets">
              {c.best.map(b => <li>{b}</li>)}
            </ul>
            <span class="label" style="margin-top:18px">Watch out for</span>
            <ul class="bullets bullets--warn">
              {c.watch.map(w => <li>{w}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <p class="price-note" style="margin-top:24px">
        <b>Our position:</b> we do not push one platform. If you already have people who
        know one of them, that is worth more than any feature difference. If you do not,
        we will recommend one, explain why in a sentence, and set it up. Migration later
        is a normal, priced project — but it should not be the default answer to a
        setup you have not started yet.
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="after-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">After the setup</p>
          <h2 id="after-title">Then what? Two honest options.</h2>
        </div>
        <p class="intro">
          A setup that nobody maintains becomes a setup that nobody trusts. These are
          the two sensible ways forward, and one of them is not us.
        </p>
      </div>

      <div class="cells cols-2">
        <article class="svc">
          <div class="svc-top"><span class="label">OPTION A</span></div>
          <h3>Your team takes it</h3>
          <p class="promise">
            The handover is the deliverable. Your developers get the runbooks, the
            pipeline, the access list and a walkthrough, and from then on it is yours.
          </p>
          <ul class="bullets">
            <li>No ongoing fee.</li>
            <li>We are available for a one-off question later, but we are not on call.</li>
            <li>The right choice if you have developers who want to own this.</li>
          </ul>
        </article>

        <article class="svc">
          <div class="svc-top"><span class="label">OPTION B</span></div>
          <h3>We keep it running</h3>
          <p class="promise">
            Managed infrastructure and support, on a monthly engagement, with the
            same environment we just built.
          </p>
          <ul class="bullets">
            <li><b>{managed.amount}{managed.per.includes('per month') ? '/mo' : ''}</b> — patching, monitoring, restore drills, helpdesk triage and a written response path.</li>
            <li>Three-month minimum, business-hours response.</li>
            <li>The right choice if nobody on your team wants to own it.</li>
          </ul>
          <a class="link" href="/services/#managed">See what managed covers <span aria-hidden="true">→</span></a>
        </article>
      </div>

      <div class="owner-note">
        <span class="label" style="color:var(--accent-ink)">What this is not</span>
        <span>
          <ul class="plain-list">
            {notFor.map(n => <li>{n}</li>)}
          </ul>
        </span>
      </div>
    </div>
  </section>

  <section class="section" id="checklist" aria-labelledby="checklist-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Free</p>
          <h2 id="checklist-title">The checklist we work from.</h2>
        </div>
        <p class="intro">
          This is the list we run through on every setup, in this order. It is free,
          printable, and written to be useful on its own — if you work through it and
          your environment is already sound, you do not need us.
        </p>
      </div>

      <div class="actions">
        <a class="btn btn-solid" href="/checklist/">Open the full checklist <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CtaBlock
    title="Tell us what you are running"
    text="Plain words are fine. “An API and a Postgres database on a small VM, deployed by hand, and I do not know what happens if the disk fills up” is enough to start. We will tell you whether a setup is the right scope, or whether you need something else."
  />
</BaseLayout>
