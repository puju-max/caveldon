---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsightCard from '../../components/InsightCard.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { visibleInsights, categoryLabels } from '../../lib/content';
const posts = await visibleInsights();
const categories = [...new Set(posts.map(post => post.data.category))];
---
<BaseLayout title="Insights · Practical cloud guides" description="Practical cloud engineering guides on architecture, security, governance, reliability, migration and cost decisions, with platform-specific detail where relevant.">
  <section class="page-hero gridpaper">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Insights</span></nav>
      <p class="eyebrow">Insights</p>
      <h1>Practical perspectives on cloud engineering.</h1>
      <p class="lead">Clear technical guides on AWS, Azure, reliability, security, governance and cloud costs. Written to be useful whether or not you work with us.</p>
    </div>
  </section>

  <section class="section" aria-label="Articles">
    <div class="wrap">
      {categories.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by topic">
          <button type="button" data-filter="all" aria-pressed="true">All topics</button>
          {categories.map(c => <button type="button" data-filter={c} aria-pressed="false">{categoryLabels[c]}</button>)}
        </div>
      )}
      {posts.length > 0
        ? <div class:list={["cells", posts.length % 3 === 0 ? "cols-3" : "cols-2"]}>{posts.map((post, i) => <InsightCard post={post} index={i} />)}</div>
        : <p class="callout">The first guides are being reviewed and will appear here soon.</p>}
    </div>
  </section>

  <CtaBlock />
</BaseLayout>
