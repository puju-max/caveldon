---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import StudyDiagram from '../../components/diagrams/StudyDiagram.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { studies } from '../../data/work.js';
---
<BaseLayout title="Engineering Lab · Reference designs" description="Reference designs showing how CAVELDON approaches cloud platforms, security evidence and cost-versus-reliability decisions: the problem, the trade-offs and how we'd prove it works.">
  <JsonLd data={breadcrumbSchema([{ name: 'Work', path: '/work/' }])} />
  <section class="page-hero gridpaper">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Work</span></nav>
      <p class="eyebrow">Work</p>
      <h1>Architecture decisions, made visible.</h1>
      <p class="lead">Explore proposed reference architectures, trade-offs, validation plans and technical reasoning. These studies are not presented as completed customer projects.</p>
      <p class="callout" style="margin-top:28px;max-width:62ch"><strong>To be clear:</strong> CAVELDON is a new practice. These are reference designs, not client stories or work inherited from a founder’s previous employment. We publish them so you can judge our thinking before you hire us. CAVELDON case studies will appear only with each client’s permission.</p>
    </div>
  </section>

  <section class="section" aria-label="Reference designs">
    <div class="wrap study-cards">
      {studies.map(s => (
        <a class="study-card" href={`/work/${s.slug}/`}>
          <div>
            <span class="cell-num">{s.number} / 03 · {s.category}</span>
            <h2>{s.title}</h2>
            <p>{s.summary}</p>
            <p style="margin-top:14px"><strong style="color:var(--ink)">The problem:</strong> {s.buyer}</p>
            <span class="link">Read the design <span aria-hidden="true">→</span></span>
          </div>
          <div aria-hidden="true"><StudyDiagram slug={s.slug} label={s.diagramAlt} /></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="evidence-source-title">
    <div class="wrap two-col">
      <div><p class="eyebrow">Evidence labels</p><h2 id="evidence-source-title">Three sources, never blended together.</h2></div>
      <div class="rows">
        <div class="row"><span class="cell-num">01</span><div><h3>CAVELDON client work</h3><p>Published only when delivered through CAVELDON and authorized by the customer.</p></div></div>
        <div class="row"><span class="cell-num">02</span><div><h3>Prior professional experience</h3><p>Experience gained before CAVELDON is identified as such and kept within confidentiality boundaries.</p></div></div>
        <div class="row"><span class="cell-num">03</span><div><h3>Engineering Lab</h3><p>Independent reference designs with explicit implementation and validation status.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="standard-title">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">Our proof standard</p><h2 id="standard-title">A diagram is a start. Evidence is the finish.</h2></div>
        <p class="intro">Anyone can draw boxes. Each design answers three questions.</p>
      </div>
      <div class="cells cols-3">
        <div><span class="cell-num">01 · EXPLAIN</span><h3 style="margin:12px 0 8px">What’s the real constraint?</h3><p style="color:var(--ink-2);font-size:16px">The business problem, the system boundary, and what matters most.</p></div>
        <div><span class="cell-num">02 · DECIDE</span><h3 style="margin:12px 0 8px">What are the trade-offs?</h3><p style="color:var(--ink-2);font-size:16px">The alternatives, and the cost and complexity each one adds.</p></div>
        <div><span class="cell-num">03 · VERIFY</span><h3 style="margin:12px 0 8px">What would prove it?</h3><p style="color:var(--ink-2);font-size:16px">The tests, records and signals needed before saying “it works”.</p></div>
      </div>
    </div>
  </section>

  <CtaBlock />
</BaseLayout>
