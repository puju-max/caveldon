---
/**
 * The community page.
 *
 * This is the page that makes a profile credible. On Reddit, Hacker News,
 * LinkedIn and X, people check "who is this?" before they read anything. So
 * this page does three things:
 *
 *   1. States plainly who we are, what we do and what we do not do.
 *   2. Lists every channel we exist on, and is explicit about which are live
 *      and which are planned — rather than linking to an empty profile.
 *   3. Publishes the rules we follow in other people's communities. This is
 *      the part that reads as professional: it is much rarer than it should be.
 *
 * It also carries the copy-paste bio, because the most common place a buyer
 * meets us is a Reddit comment and a dev.to signature.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CtaBlock from '../components/CtaBlock.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SignalStrip from '../components/SignalStrip.astro';
import { channels, liveChannels, tierLabels, tierNotes, type Tier } from '../data/social';
import { site } from '../data/site';

const tiers: Tier[] = ['work', 'founder', 'community'];
const planned = channels.filter(c => !c.live);

const behaviour = [
  {
    t: 'We disclose who we are, every time',
    d: 'On any platform where we have a commercial interest, we say we are a commercial vendor in the first post, not in a footnote three weeks later. If someone asks us to run an audit for free and we say no, we say no and we say why.',
  },
  {
    t: 'We do not drop links into other people’s threads',
    d: 'Where a community asks for no promotional links, we post no promotional links. Not softened ones, not "check my profile" ones. If our work is relevant we describe it and let the reader find us.',
  },
  {
    t: 'We recommend the competitor when the competitor is right',
    d: 'If another tool does the job better for the person asking, we say so. Trustyourinbox already white-labels email authentication at $2 a domain a month, so we do not sell that check standalone. Our credibility is worth more than the small sale.',
  },
  {
    t: 'We publish the method, not the marketing',
    d: 'Every guide on this site answers a question we were actually asked, with the reasoning and the limits. No "in today’s fast-paced landscape". No pretending a checklist is a certification.',
  },
  {
    t: 'We do not sell a certification we cannot issue',
    d: 'We do not issue audit reports, certifications or legal opinions. We prepare the technical evidence and build the controls so that a qualified auditor can do their job. Saying so clearly is part of the product.',
  },
  {
    t: 'We never ask for client credentials',
    d: 'Every restore drill and every review runs inside the client’s own cloud account, under access the client grants and can revoke. We do not ask for shared logins, keys or passwords — not even for a free assessment.',
  },
];

const content = [
  { t: 'Guides', d: 'Long-form, specific, written to be useful whether or not you buy anything. Canonical version lives here; other platforms carry a link back to it.', where: '/insights/' },
  { t: 'Engineering Lab', d: 'Reference designs with the decisions, the trade-offs and an explicit validation plan. These are designs, not completed client work, and we label them that way.', where: '/work/' },
  { t: 'The small-environment checklist', d: 'The list we work from when we set up an environment for a team that knows the code but not the infrastructure. Free, printable, and written to be used without us.', where: '/checklist/' },
  { t: 'Findings and short takes', d: 'A real misconfiguration, what it enables, and the fix. Short enough to read on a phone.', where: 'X, LinkedIn' },
];
---

<BaseLayout
  title="Community &amp; profiles"
  description="Where CAVELDON is online, what we post, and the rules we follow in other people's communities. Every profile, cadence and commitment in one place."
>
  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'CAVELDON community and profiles',
    description: 'Every CAVELDON profile, what it is for, and how we take part in other people’s communities.',
    ...(liveChannels.length ? { mainEntity: { '@type': 'Organization', name: site.name, sameAs: liveChannels.map(c => c.url) } } : {}),
  }} />

  <section class="page-hero gridpaper">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Community</span></nav>
      <p class="eyebrow">Profiles &amp; community</p>
      <h1>Where we are, and how we behave.</h1>
      <p class="lead">
        Every channel we are on, what belongs on it, and the rules we follow in
        communities that are not ours. If you found us in a thread and want to
        check whether we are real, this page is the answer.
      </p>
      <div style="margin-top:24px"><SocialLinks size="md" labelled /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="short-version">
    <div class="wrap">
      <h2 id="short-version" class="sr-only">The short version</h2>
      <SignalStrip />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="bio-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Copy-paste</p>
          <h2 id="bio-title">The bio, in three lengths.</h2>
        </div>
        <p class="intro">
          Use whichever fits. The short one goes in a Reddit signature or an X
          bio. The long one goes in a LinkedIn profile or a forum post.
        </p>
      </div>

      <div class="bio-stack">
        <div class="bio-block">
          <span class="label">One line</span>
          <p class="bio-text">CAVELDON — founder-led cloud, security and managed-operations engineering. We fix the infrastructure you already have, and prove it with evidence.</p>
        </div>
        <div class="bio-block">
          <span class="label">Two lines</span>
          <p class="bio-text">CAVELDON — a founder-led cloud engineering practice. We work with growing software teams and with the MSPs who serve them: reviews, migrations, security and audit readiness, managed infrastructure, and cost work. Fixed scope, published prices, no retainers we cannot justify.</p>
        </div>
        <div class="bio-block">
          <span class="label">Full</span>
          <p class="bio-text">
            I run {site.name}, a one-person cloud and operational engineering practice.
            We do four things: cloud and platform engineering, security, governance and
            compliance readiness, managed infrastructure and support, and reliability and
            cloud cost work. Two ways to buy it — a team engages us directly, or an MSP
            engages us and resells the work to their own client under their own name.
            Everything we produce is written down: findings, runbooks, code, and the
            evidence an insurer or an auditor will ask for. I write up what we learn at
            <a class="link" href="/insights/">/insights/</a>, and there is a free
            <a class="link" href="/checklist/">small-environment checklist</a> you can work through yourself.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="channels-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Channels</p>
          <h2 id="channels-title">Every profile, and what it is for.</h2>
        </div>
        <p class="intro">
          Channels marked <b>planned</b> are shown with their address but are not
          linked, because an empty profile is worse than no profile. We will link
          one the day it has real content on it.
        </p>
      </div>

      <div class="chan-groups">
        {tiers.map(tier => {
          const list = channels.filter(c => c.tier === tier);
          if (!list.length) return null;
          return (
            <section class="chan-group" aria-label={tierLabels[tier]}>
              <header class="chan-group-head">
                <h3>{tierLabels[tier]}</h3>
                <p>{tierNotes[tier]}</p>
              </header>
              <div class="chan-list">
                {list.map(c => (
                  <article class:list={['chan', { 'chan--planned': !c.live }]}>
                    <div class="chan-id">
                      <span class="chan-mark" aria-hidden="true">{c.monogram}</span>
                      <div>
                        <span class="chan-name">{c.label}</span>
                        <span class="chan-handle">{c.handle}</span>
                      </div>
                    </div>
                    <div class="chan-body">
                      <p class="chan-purpose">{c.purpose}</p>
                      <p class="chan-cadence"><b>Cadence:</b> {c.cadence}</p>
                    </div>
                    <div class="chan-end">
                      {c.live
                        ? <a class="link" href={c.url} rel="me noopener" target="_blank">Visit <span aria-hidden="true">→</span></a>
                        : <span class="chan-planned">Planned</span>}
                      <span class="chan-priority" title={`Priority ${c.priority} of 3`}>P{c.priority}</span>
                    </div>
                    {!c.live && c.availability && (
                      <p class:list={['chan-avail', `chan-avail--${c.availability.result}`]}>
                        {c.availability.result === 'available' && (
                          <>Handle confirmed free on {c.availability.checked}. {c.availability.note}</>
                        )}
                        {c.availability.result === 'unknown' && (
                          <>Availability unknown — {c.availability.checked}. {c.availability.note}</>
                        )}
                        {c.availability.result === 'taken' && (
                          <>Handle taken on {c.availability.checked}. {c.availability.note}</>
                        )}
                      </p>
                    )}
                  </article>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="behaviour-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Community rules</p>
          <h2 id="behaviour-title">How we behave in places that are not ours.</h2>
        </div>
        <p class="intro">
          Most people who post in a technical forum can tell within one message
          whether a vendor is there to help or to sell. These are the rules we
          hold ourselves to, written down so you can hold us to them.
        </p>
      </div>

      <div class="cells cols-2">
        {behaviour.map((b, i) => (
          <article class="rule">
            <span class="rule-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="content-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What we publish</p>
          <h2 id="content-title">Four things, on repeat.</h2>
        </div>
        <p class="intro">
          Everything we publish fits one of these. If a post does not fit, we
          do not post it.
        </p>
      </div>

      <div class="cells cols-2">
        {content.map(c => (
          <article class="pub">
            <h3>{c.t}</h3>
            <p>{c.d}</p>
            <a class="link" href={c.where.startsWith('/') ? c.where : '#'}>See it <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {planned.length > 0 && (
    <section class="section section--alt" aria-labelledby="planned-title">
      <div class="wrap">
        <h2 id="planned-title">Being honest about the rest</h2>
        <p class="intro" style="margin-bottom:24px">
          These are the channels we have reserved or intend to open. They are
          listed so nothing is a surprise, and none of them are linked yet.
        </p>
        <ul class="planned-list">
          {planned.map(c => (
            <li>
              <span class="chan-mark" aria-hidden="true">{c.monogram}</span>
              <span class="planned-name">{c.label}</span>
              <span class="planned-url mono">{c.url}</span>
              <span class="chan-priority">P{c.priority}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBlock
    title="The fastest way to judge us"
    text="Send us the situation in plain words — what you are running, what it needs to do, and what keeps going wrong. We will tell you whether this is something we can help with, and what it would cost, before you commit to anything."
  />
</BaseLayout>
