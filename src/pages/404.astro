---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This CAVELDON page could not be found.">
  <section class="page-hero gridpaper" style="min-height:60vh">
    <div class="wrap">
      <p class="eyebrow">404 · Page not found</p>
      <h1>That page isn’t here.</h1>
      <p class="lead">The link may be old, or the page may have moved.</p>
      <div class="actions"><a class="btn btn-solid" href="/">Go to the homepage <span class="arr" aria-hidden="true">→</span></a><a class="btn btn-ghost" href="/services/">See services</a></div>
    </div>
  </section>
</BaseLayout>
