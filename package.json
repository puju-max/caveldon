{
  "name": "caveldon-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "check:motion": "node scripts/check-motion.mjs",
    "syndicate": "node scripts/syndicate.mjs",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run build && npm run check:motion && npm run check:site",
    "build:live": "PUBLIC_SITE_LIVE=true astro build",
    "make:avatars": "node scripts/make-avatars.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
