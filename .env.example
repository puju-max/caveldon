# Keep drafts and prelaunch pages out of search indexes during development.
PUBLIC_SITE_LIVE=false
# The launch domain. caveldon.com and caveldon.in were both verified unregistered
# on 20 Oct 2026 — register both before setting this to a live URL.
PUBLIC_SITE_URL=https://caveldon.com

# Where every "Book a call" button goes, e.g. a Cal.com or Calendly link.
# Leave empty and the buttons go to the contact form instead.
PUBLIC_BOOKING_URL=

# Contact system: keep both empty for copy-only prelaunch mode.
# API Gateway POST endpoint (NOT an AWS access key or secret).
PUBLIC_CONTACT_API_URL=
# Cloudflare Turnstile PUBLIC site key. Never put its secret here.
PUBLIC_TURNSTILE_SITE_KEY=
# Optional: show a real email alternative ONLY after your business mailbox exists.
# On a live site without the API above, the contact page shows this address
# instead of a form that cannot deliver — which is honest, and it works.
PUBLIC_CONTACT_EMAIL=hello@caveldon.com

# Cookie-free analytics (only loads when PUBLIC_SITE_LIVE=true). Pick one provider:
#   plausible  -> PUBLIC_ANALYTICS_ID=your-domain.com
#   umami      -> PUBLIC_ANALYTICS_ID=<website id>
#   cloudflare -> PUBLIC_ANALYTICS_ID=<beacon token> (page views only)
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=
# Optional: custom script URL (self-hosted Umami/Plausible, or Plausible's per-site script)
PUBLIC_ANALYTICS_SRC=
